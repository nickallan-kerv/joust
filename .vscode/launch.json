{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Joust in Browser",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "npm: dev"
        },
        {
            "name": "Run Sprite Inspector in Browser",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5173/sprite-inspector/",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "npm: dev"
        }
    ]
}